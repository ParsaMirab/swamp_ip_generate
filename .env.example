# Telegram bot token, issued by @BotFather.
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# Comma separated list of Telegram user IDs allowed to open /admin.
# Example: 123456789,987654321
ADMIN_IDS=

# Where the SQLite database (used to persist the replacement IP) is stored.
# Relative paths are resolved from the project root.
DATABASE_PATH=data/swamp.sqlite3
